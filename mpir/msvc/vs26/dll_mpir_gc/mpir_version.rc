#include <windows.h>

// MpfrDotNet: version information of the DLL. FILEVERSION and PRODUCTVERSION are the version of MPIR, update
// them with the sources.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION     3,0,0,0
 PRODUCTVERSION  3,0,0,0
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS       VS_FF_DEBUG
#else
 FILEFLAGS       0
#endif
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_DLL
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription",  "MPIR, multiple-precision integer and rational library"
            VALUE "FileVersion",      "3.0.0"
            VALUE "ProductName",      "MPIR"
            VALUE "ProductVersion",   "3.0.0"
            VALUE "LegalCopyright",   "Copyright Free Software Foundation, Inc., William Hart and others. LGPL-3.0-or-later"
            VALUE "OriginalFilename", "mpir.dll"
            VALUE "Comments",         "Built for MpfrDotNet, https://github.com/dlebansais/MpfrDotNet"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
