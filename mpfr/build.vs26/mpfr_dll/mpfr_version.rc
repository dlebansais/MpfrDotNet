#include <windows.h>

// MpfrDotNet: version information of the DLL. FILEVERSION and PRODUCTVERSION are the version of MPFR, update
// them with the sources.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION     4,2,1,0
 PRODUCTVERSION  4,2,1,0
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS       VS_FF_DEBUG
#else
 FILEFLAGS       0
#endif
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_DLL
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription",  "GNU MPFR, multiple-precision floating-point library"
            VALUE "FileVersion",      "4.2.1-dev"
            VALUE "ProductName",      "MPFR"
            VALUE "ProductVersion",   "4.2.1-dev"
            VALUE "LegalCopyright",   "Copyright 1999-2023 Free Software Foundation, Inc. LGPL-3.0-or-later"
            VALUE "OriginalFilename", "mpfr.dll"
            VALUE "Comments",         "Built for MpfrDotNet, https://github.com/dlebansais/MpfrDotNet"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
